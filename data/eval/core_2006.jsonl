{"id": "hn24-II1", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Để chở 15 tấn thiết bị, một đội dự định dùng xe tải nhỏ. Do thay đổi kế hoạch, đội chỉ dùng xe tải lớn nên số xe giảm 2 xe và mỗi xe lớn chở nhiều hơn mỗi xe nhỏ 2 tấn. Hỏi đội dùng bao nhiêu xe tải lớn?", "gold": {"topic": "ALG-6", "goal_type": "word_problem", "difficulty": 2, "answer": "3 xe"}, "eval_set": "core_2006", "tags": [], "verified": true, "answer_source": "hdc_so"}
{"id": "hn24-II2", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Một bình nước hình trụ bán kính đáy 4 cm, chiều cao 25 cm. Tính diện tích xung quanh (π ≈ 3,14).", "gold": {"topic": "GEO-10", "goal_type": "compute_area", "difficulty": 1, "answer": "628 cm²"}, "eval_set": "core_2006", "tags": ["thuc_tien"], "verified": true, "answer_source": "hdc_so"}
{"id": "hn24-III1", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Giải hệ phương trình: √(3x + 1) + 2y = 4 và 3√(3x + 1) − y = 5.", "gold": {"topic": "ALG-1", "goal_type": "solve_system", "difficulty": 1, "answer": "(x; y) = (1; 1)"}, "eval_set": "core_2006", "tags": [], "verified": true, "answer_source": "hdc_so"}
{"id": "hn24-III2a", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Trong mặt phẳng Oxy, cho parabol (P): y = x² và đường thẳng (d): y = (m − 2)x + 5. Chứng minh (d) luôn cắt (P) tại hai điểm phân biệt.", "gold": {"topic": "ALG-6", "goal_type": "analyze_function", "difficulty": 1, "answer": "Δ = (m − 2)² + 20 > 0"}, "eval_set": "core_2006", "tags": [], "verified": true, "context_id": "hn24-III2", "answer_source": "hdc_so"}
{"id": "hn24-III2b", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Trong mặt phẳng Oxy, cho parabol (P): y = x² và đường thẳng (d): y = (m − 2)x + 5. Gọi x₁, x₂ là hoành độ các giao điểm. Tìm m để x₁ + 5x₂ = 0.", "gold": {"topic": "ALG-6", "goal_type": "find_parameter", "difficulty": 2, "answer": "m = −2 hoặc m = 6"}, "eval_set": "core_2006", "tags": [], "verified": true, "context_id": "hn24-III2", "answer_source": "hdc_so"}
{"id": "hn24-IV1", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Từ điểm A nằm bên ngoài đường tròn (O), kẻ hai tiếp tuyến AB, AC (B, C là tiếp điểm). Chứng minh tứ giác ABOC nội tiếp.", "gold": {"topic": "GEO-9", "goal_type": "prove_concyclic", "difficulty": 1, "answer": null, "predicates": [{"kind": "concyclic", "args": ["A", "B", "O", "C"]}]}, "eval_set": "core_2006", "tags": [], "verified": true, "context_id": "hn24-IV", "answer_source": "hdc_so"}
{"id": "hn24-IV2", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Từ điểm A nằm bên ngoài đường tròn (O), kẻ hai tiếp tuyến AB, AC (B, C là tiếp điểm). Vẽ đường kính BD. E là giao điểm thứ hai của AD với (O). BC cắt AO tại H. Chứng minh AB² = AE.AD = AH.AO và góc HDO = góc HBE.", "gold": {"topic": "GEO-9", "goal_type": "prove_equal_length", "difficulty": 2, "answer": null, "predicates": [{"kind": "product_equal", "args": ["A", "B", "A", "B", "A", "E", "A", "D"]}, {"kind": "product_equal", "args": ["A", "B", "A", "B", "A", "H", "A", "O"]}, {"kind": "equal_angle", "args": ["H", "D", "O", "H", "B", "E"]}]}, "eval_set": "core_2006", "tags": [], "verified": true, "context_id": "hn24-IV", "notes": "Đáp án Sở dùng hệ thức lượng trong tam giác vuông ABD, không dùng góc tiếp tuyến–dây.", "answer_source": "hdc_so"}
{"id": "hn24-IV3", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Từ điểm A nằm bên ngoài đường tròn (O), kẻ hai tiếp tuyến AB, AC (B, C là tiếp điểm). Lấy M thuộc tia đối của tia CB, N là chân đường vuông góc từ M đến AB. Chứng minh BE đi qua trung điểm của MN.", "gold": {"topic": "GEO-9", "goal_type": "prove_collinear", "difficulty": 3, "answer": null, "predicates": [{"kind": "collinear", "args": ["B", "E", "K"]}]}, "eval_set": "core_2006", "tags": [], "verified": true, "context_id": "hn24-IV", "notes": "K là trung điểm MN (điểm phụ trong kịch bản dựng hình).", "answer_source": "hdc_so"}
{"id": "hn24-V", "source": "Tuyển sinh 10 Hà Nội 2024", "curriculum": "2006", "format": "tu_luan", "statement": "Với các số thực dương x, y thỏa x + y + xy = 3, tìm giá trị nhỏ nhất của P = 3/(x + y) − xy.", "gold": {"topic": "ALG-2", "goal_type": "find_max_min", "difficulty": 3, "answer": "1/2 (tại x = y = 1)"}, "eval_set": "core_2006", "tags": [], "verified": true, "answer_source": "hdc_so"}
