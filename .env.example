# Model API mạnh — dùng cho Solver ở bài mức 2 và 3
ANTHROPIC_API_KEY=

# Endpoint model local (vLLM / Ollama / SGLang phục vụ Qwen3)
LOCAL_LLM_URL=http://localhost:8000/v1

# OCR đề bài từ ảnh
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Theo dõi từng lượt hỏi — cần để biết model sai ở đâu
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
