# Model chính — giao thức OpenAI. Cần model đọc được ảnh nếu muốn gửi ảnh đề.
OPENAI_API_KEY=
MODEL_NAME=gpt-4.1-mini
# OPENAI_BASE_URL=http://localhost:8001/v1   # vLLM/Ollama local (đừng trùng cổng 8000 của API)

# Model API mạnh — dự kiến cho Solver ở bài mức 2 và 3 (chưa dùng)
ANTHROPIC_API_KEY=

# Endpoint model local — chỉ dùng khi KHÔNG có OPENAI_API_KEY
LOCAL_LLM_URL=http://localhost:8001/v1

# Production
# RAG_REQUIRE_REVIEWED=1
# CORS_ORIGINS=http://localhost:3000

# OCR đề bài bằng Mathpix (tùy chọn — Parser hiện đọc ảnh bằng VLM)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Theo dõi từng lượt hỏi (chưa nối)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
