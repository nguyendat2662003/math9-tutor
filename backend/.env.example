# Model chính — giao thức OpenAI. Cần model đọc được ảnh nếu muốn gửi ảnh đề.
OPENAI_API_KEY=
MODEL_NAME=gpt-4.1-mini
# OPENAI_BASE_URL=http://localhost:8001/v1   # vLLM/Ollama local (đừng trùng cổng 8000 của API)

# Model API mạnh — dự kiến cho Solver ở bài mức 2 và 3 (chưa dùng)
ANTHROPIC_API_KEY=

# Endpoint model local — chỉ dùng khi KHÔNG có OPENAI_API_KEY
LOCAL_LLM_URL=http://localhost:8001/v1

# Production
# RAG_REQUIRE_REVIEWED=1
# Domain của frontend, cách nhau bởi dấu phẩy (vd. https://math9.vercel.app)
# CORS_ORIGINS=http://localhost:3000

# OCR đề bài bằng Mathpix (tùy chọn — Parser hiện đọc ảnh bằng VLM)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Tài khoản học sinh + lịch sử — PostgreSQL trên Supabase (Connect -> Session pooler, KHÔNG dùng
# Direct connection: gói miễn phí chỉ có IPv6). Bỏ trống = SQLite data/app.db (chỉ để phát triển).
DATABASE_URL=
# Số bài mỗi học sinh được giải mỗi ngày (giờ Việt Nam) — giữ chi phí gọi model trong tầm kiểm soát
SOLVE_DAILY_LIMIT=30
# Hỏi đáp sau khi giải: số câu hỏi tối đa mỗi bài / mỗi ngày (mỗi câu là một lượt gọi model)
CHAT_PER_SOLVE_LIMIT=15
CHAT_DAILY_LIMIT=100
# Bật khi chạy qua HTTPS (cookie phiên chỉ gửi qua kết nối mã hóa)
# COOKIE_SECURE=1
# Frontend gọi THẲNG backend ở tên miền khác (không qua proxy /api của Next.js) -> đặt none
# (tự bật Secure, cần HTTPS). Đi qua proxy (khuyên dùng) thì giữ mặc định lax.
# COOKIE_SAMESITE=lax

# Kho đề Qdrant (pip install -e ".[kho]") — tải đề lên hằng ngày ở /admin, gợi ý bài tương tự.
# Qdrant Cloud: đặt QDRANT_URL + QDRANT_API_KEY. Chưa có Cloud: QDRANT_PATH=data/qdrant (lưu cục bộ,
# chỉ một tiến trình mở được — tắt API trước khi chạy tools/index_bank.py). Không đặt gì = tắt.
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_PATH=data/qdrant
# EMBEDDING_MODEL=text-embedding-3-small

# Tracing lên Langfuse (pip install -e ".[tracing]"). Bỏ trống = tắt; LANGFUSE_TRACING=0 để tắt tạm
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
