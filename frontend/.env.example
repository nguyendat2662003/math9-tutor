# Địa chỉ backend mà TRÌNH DUYỆT gọi tới (nhúng vào bundle lúc build — đổi thì phải build lại).
# Chạy cục bộ: bỏ trống -> mặc định http://localhost:8000
#
# Deploy, cách 1 (khuyên dùng) — đi qua proxy của Next.js, cookie cùng tên miền:
#   NEXT_PUBLIC_API_URL=
#   BACKEND_URL=https://math9-api.onrender.com
# (để NEXT_PUBLIC_API_URL là chuỗi rỗng, KHÔNG xóa dòng)
#
# Deploy, cách 2 — gọi thẳng backend khác tên miền:
#   NEXT_PUBLIC_API_URL=https://math9-api.onrender.com
#   và ở backend: CORS_ORIGINS=<domain frontend>, COOKIE_SAMESITE=none
#   (Safari chặn cookie bên thứ ba -> đăng nhập có thể hỏng; nên dùng cách 1)
NEXT_PUBLIC_API_URL=http://localhost:8000
# BACKEND_URL=
